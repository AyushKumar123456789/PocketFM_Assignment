# ─── LLM provider — pick ONE ─────────────────────────────────────────────

# Option A (free tier, recommended): Google Gemini.
# Get a key — no credit card — at https://aistudio.google.com/apikey
# Then set the default model to gemini-2.5-flash (see GOAGENT_MODEL below).
GEMINI_API_KEY=

# Option B: Anthropic Claude. Paid (no free tier as of 2026).
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── Optional ────────────────────────────────────────────────────────────

# GitHub token for fetching issues. Public-repo reads work without this
# but the rate limit is low. Create at https://github.com/settings/tokens
# with scope `public_repo`.
GITHUB_TOKEN=

# Default model. Provider is inferred from the prefix:
#   gemini-2.5-flash, gemini-2.5-pro   → uses GEMINI_API_KEY
#   claude-sonnet-4-6, claude-opus-4-7 → uses ANTHROPIC_API_KEY
GOAGENT_MODEL=gemini-2.5-flash

# Per-stage cost cap in USD. The agent aborts above this. Default 5.00.
# Free-tier Gemini reports $0 so this is mostly a safety net for Claude.
GOAGENT_MAX_COST=5.00
